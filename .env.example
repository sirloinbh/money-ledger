POSTGRES_DB=money
POSTGRES_USER=money
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://money:change-this-local-password@localhost:15405/money
PORT=3105

# Price and exchange rate API keys (docs/price-source.md, #85). They come from AWS SSM: the server deploy reads them,
# and `node tools/app-secrets.mjs pull money-ledger` in project-standards writes them into .env.
# @desc KRX Open API auth key (domestic daily prices, AUTH_KEY header) @secret @used=backend @ssm=/sirloinbh/money-ledger/krx-api-key
KRX_API_KEY=
# @desc Tiingo API token (US prices) @secret @used=backend @ssm=/sirloinbh/money-ledger/tiingo-api-key
TIINGO_API_KEY=
# @desc Korea Eximbank exchange rate API auth key (KRW/USD) @secret @used=backend @ssm=/sirloinbh/money-ledger/koreaexim-api-key
KOREAEXIM_API_KEY=
# fake: use fake prices without keys (for tests and screen checks). off: do not run the daily fetch.
PRICE_SOURCE=
PRICE_JOBS=
