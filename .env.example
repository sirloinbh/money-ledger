POSTGRES_DB=money
POSTGRES_USER=money
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://money:change-this-local-password@localhost:15405/money
PORT=3105

# Price and exchange rate API keys (docs/price-source.md, #85). Put the values only in .env.
KRX_API_KEY=
TIINGO_API_KEY=
KOREAEXIM_API_KEY=
# fake: use fake prices without keys (for tests and screen checks). off: do not run the daily fetch.
PRICE_SOURCE=
PRICE_JOBS=
