POSTGRES_DB=money
POSTGRES_USER=money
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://money:change-this-local-password@localhost:15405/money
PORT=3105
# Deploy contract (#179, deploy/remote-deploy.sh). Unset locally: compose builds `money-backend:local` and
# `money-frontend:local` and serves the web on 127.0.0.1:8105. The deploy sets IMAGE_TAG to the commit, so a rollback
# starts the earlier image; on the first deploy deploy/bootstrap-env.sh writes WEB_BIND and WEB_PORT into the server .env.
# IMAGE_TAG=local
# WEB_BIND=127.0.0.1
# WEB_PORT=8105
# The shared sign-in (#149). Unset for local development without it; compose sets it on the server.
# AUTH_INTERNAL_URL=http://shared-auth-api:3110
# @desc shared-ai's Ed25519 public key (PEM, one line with \n escapes). Set: the API serves its AI tools at /internal/tools; empty: no tools @secret @used=backend,compose @ssm=/sirloinbh/shared/ai-tools-public-key
AI_TOOLS_PUBLIC_KEY=

# Price and exchange rate API keys (docs/price-source.md, #85). They come from AWS SSM: the server deploy reads them,
# and `node tools/app-secrets.mjs pull money-ledger` in project-standards writes them into .env.
# @desc KRX Open API auth key (domestic daily prices, AUTH_KEY header) @secret @used=backend @ssm=/sirloinbh/money-ledger/krx-api-key
KRX_API_KEY=
# @desc Tiingo API token (US prices) @secret @used=backend @ssm=/sirloinbh/money-ledger/tiingo-api-key
TIINGO_API_KEY=
# @desc Korea Eximbank exchange rate API auth key (KRW/USD) @secret @used=backend @ssm=/sirloinbh/money-ledger/koreaexim-api-key
KOREAEXIM_API_KEY=
# fake: use fake prices without keys (for tests and screen checks). PRICE_JOBS=off: do not run the daily fetch (old switch, same as JOBS_MODE=off).
PRICE_SOURCE=
PRICE_JOBS=
# off: no background jobs at all (JOBS_MODE=off does the same); send: this server only queues jobs, it does not work them.
JOBS_MODE=
