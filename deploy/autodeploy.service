# 중앙 관리 파일. 수정은 sirloinbh/project-standards의 templates/app/deploy/에서
[Unit]
Description=가계부·자산 포트폴리오 pull-based deployment of origin/main
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/money-ledger
# Copied first: the deploy checks out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/money-ledger/deploy/autodeploy.sh /tmp/money-autodeploy.sh && exec /bin/bash /tmp/money-autodeploy.sh'
TimeoutStartSec=45min
Nice=10
