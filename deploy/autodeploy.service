# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Money Ledger pull-based deployment of origin/main
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/money-ledger
# Copied first: the deploy checks out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/money-ledger/deploy/autodeploy.sh /tmp/money-autodeploy.sh && exec /bin/bash /tmp/money-autodeploy.sh'
TimeoutStartSec=45min
Nice=10
