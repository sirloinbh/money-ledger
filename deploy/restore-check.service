# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Money Ledger weekly restore check of the newest database dump
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/money-ledger
ExecStart=/bin/bash -c 'cp /opt/money-ledger/deploy/backup.sh /tmp/money-restore-check.sh && exec /bin/bash /tmp/money-restore-check.sh verify'
TimeoutStartSec=30min
Nice=10
