# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Money Ledger health check signal for healthchecks.io
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/money-ledger
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/money-ledger/deploy/notify.sh /tmp/money-notify.sh && exec /bin/bash /tmp/money-notify.sh health'
TimeoutStartSec=2min
