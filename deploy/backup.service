# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Money Ledger daily database dump (and S3 copy when configured)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/money-ledger
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/money-ledger/deploy/backup.sh /tmp/money-backup.sh && exec /bin/bash /tmp/money-backup.sh dump'
TimeoutStartSec=30min
Nice=10
