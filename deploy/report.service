# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Money Ledger daily server report for healthchecks.io
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/money-ledger
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/money-ledger/deploy/report.sh /tmp/money-report.sh && exec /bin/bash /tmp/money-report.sh'
TimeoutStartSec=5min
